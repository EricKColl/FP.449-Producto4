# Copia este fichero como ".env" para cambiar los valores por defecto de docker-compose.yml.
# El fichero .env no se sube al repositorio.

DB_USER=biblioteca
DB_PASSWORD=biblioteca
DB_ROOT_PASSWORD=root

# Puertos publicados en el equipo
DB_PORT=3307
APP_PORT=8080
ADMINER_PORT=8081

# Clave que firma los tokens de la API REST (al menos 32 caracteres). Si se deja vacía, la aplicación
# genera una al arrancar y los tokens dejan de valer cada vez que se reinicia el contenedor.
BIBLIOTECA_API_CLAVE=
