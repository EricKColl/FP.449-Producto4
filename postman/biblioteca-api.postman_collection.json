{
  "info": {
    "_postman_id": "3b8b2a83-bb29-5492-bd29-53702dee2701",
    "name": "Biblioteca BackLord · API REST",
    "description": "Comprobaciones de la API REST del Producto 4 (FP065, grupo BackLord).\n\nImporta también el entorno «Biblioteca · local» y elígelo arriba a la derecha. Ejecuta la colección entera con «Run collection»: la carpeta Token guarda los tokens que usan las demás.\n\nDocumentación: {{baseUrl}}/swagger-ui.html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Token",
      "description": "Pedir los tokens. Ejecútala primero: guarda tokenAdmin y tokenUsuario para el resto de la colección.",
      "item": [
        {
          "name": "Pedir token de administración",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve un token Bearer de ADMIN\", () => {",
                  "    pm.expect(datos.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(datos.tipo).to.eql(\"Bearer\");",
                  "    pm.expect(datos.rol).to.eql(\"ADMIN\");",
                  "});",
                  "pm.collectionVariables.set(\"tokenAdmin\", datos.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Pedir token de cliente (Laura)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{usuarioEmail}}\",\n  \"password\": \"{{usuarioPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve un token de USER\", () => pm.expect(datos.rol).to.eql(\"USER\"));",
                  "pm.collectionVariables.set(\"tokenUsuario\", datos.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Contraseña incorrecta: 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"otra-contraseña\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Explica el error\", () => pm.expect(pm.response.json().detail).to.eql(\"Email o contraseña incorrectos\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ver mi cuenta",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cuenta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cuenta"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const cuenta = pm.response.json();",
                  "pm.test(\"Es la cuenta del token\", () => pm.expect(cuenta.email).to.eql(pm.environment.get(\"adminEmail\")));",
                  "pm.test(\"No devuelve la contraseña\", () => pm.expect(cuenta).to.not.have.property(\"password\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ver mi cuenta sin token: 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cuenta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cuenta"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Indica cómo pedir el token\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errores",
      "description": "Cómo responde la API cuando algo no se puede hacer: siempre JSON con status, title y detail.",
      "item": [
        {
          "name": "Ruta que no existe: 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/no-existe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "no-existe"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Formato Problem Details\", () => {",
                  "    const error = pm.response.json();",
                  "    pm.expect(error.status).to.eql(404);",
                  "    pm.expect(error.detail).to.include(\"/api/no-existe\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Token de cliente en administración: 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "usuarios"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenUsuario}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 403\", () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Se comprueba en todas las peticiones de la colección (un 204 no tiene cuerpo)",
          "if (pm.response.code !== 204) {",
          "    pm.test(\"Responde en JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/json/));",
          "}",
          "pm.test(\"Responde en menos de 2 segundos\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenUsuario",
      "value": ""
    }
  ]
}
