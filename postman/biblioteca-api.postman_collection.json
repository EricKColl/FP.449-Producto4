{
  "info": {
    "_postman_id": "3b8b2a83-bb29-5492-bd29-53702dee2701",
    "name": "Biblioteca BackLord · API REST",
    "description": "Comprobaciones de la API REST del Producto 4 (FP065, grupo BackLord).\n\nImporta también el entorno «Biblioteca · local» y elígelo arriba a la derecha. Ejecuta la colección entera con «Run collection»: la carpeta Token guarda los tokens que usan las demás.\n\nDocumentación: {{baseUrl}}/swagger-ui.html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Catálogo",
      "description": "Libros y autores abiertos a cualquiera, sin token. Búsqueda sin distinguir mayúsculas ni tildes, filtro por género, fichas y errores en JSON.",
      "item": [
        {
          "name": "Listar libros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const libros = pm.response.json();",
                  "pm.test(\"Devuelve los 14 libros por título\", () => {",
                  "    pm.expect(libros).to.be.an(\"array\").with.lengthOf(14);",
                  "    pm.expect(libros[0].titulo).to.eql(\"1984\");",
                  "});",
                  "pm.test(\"Cada libro trae título, autores y ejemplares libres\", () => {",
                  "    libros.forEach(libro => pm.expect(libro).to.include.keys(\"id\", \"titulo\", \"autores\", \"disponibles\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Buscar libros: garcia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros?q=garcia",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "garcia"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Encuentra a García Márquez sin la tilde\", () => {",
                  "    const titulos = pm.response.json().map(libro => libro.titulo);",
                  "    pm.expect(titulos).to.eql([\"Cien años de soledad\", \"Crónica de una muerte anunciada\"]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filtrar libros por género: fantasía",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros?genero=fantasia",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ],
              "query": [
                {
                  "key": "genero",
                  "value": "fantasia"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve los cuatro libros de fantasía\", () => {",
                  "    const libros = pm.response.json();",
                  "    pm.expect(libros).to.have.lengthOf(4);",
                  "    libros.forEach(libro => pm.expect(libro.genero).to.eql(\"Fantasía\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ver la ficha de un libro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros",
                "2"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const libro = pm.response.json();",
                  "pm.test(\"Es Cien años de soledad, con su autor y disponibilidad\", () => {",
                  "    pm.expect(libro.titulo).to.eql(\"Cien años de soledad\");",
                  "    pm.expect(libro.autores[0].apellidos).to.eql(\"García Márquez\");",
                  "    pm.expect(libro.ejemplares).to.eql(2);",
                  "    pm.expect(libro.disponibles).to.eql(1);",
                  "});",
                  "pm.test(\"No devuelve los préstamos ni datos de los lectores\", () => {",
                  "    pm.expect(libro).to.not.have.property(\"prestamos\");",
                  "    pm.expect(libro).to.not.have.property(\"reservas\");",
                  "    pm.expect(libro).to.not.have.property(\"marcadoPor\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Libro que no existe: 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/libros/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros",
                "999"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Explica qué falta en formato Problem Details\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    pm.expect(pm.response.json().status).to.eql(404);",
                  "    pm.expect(pm.response.json().detail).to.eql(\"No existe el libro 999\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Listar autores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/autores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autores"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve los 11 autores con cuántos libros tienen\", () => {",
                  "    const autores = pm.response.json();",
                  "    pm.expect(autores).to.be.an(\"array\").with.lengthOf(11);",
                  "    pm.expect(autores[0]).to.include.keys(\"id\", \"nombre\", \"apellidos\", \"libros\");",
                  "    pm.expect(autores[0].apellidos).to.eql(\"Allende\");",
                  "    pm.expect(autores.find(autor => autor.apellidos === \"García Márquez\").libros).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ver la ficha de un autor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/autores/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autores",
                "2"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Gabriel García Márquez con sus libros por título\", () => {",
                  "    const autor = pm.response.json();",
                  "    pm.expect(autor.nombre).to.eql(\"Gabriel\");",
                  "    pm.expect(autor.apellidos).to.eql(\"García Márquez\");",
                  "    pm.expect(autor.libros.map(libro => libro.titulo)).to.eql([",
                  "        \"Cien años de soledad\", \"Crónica de una muerte anunciada\"",
                  "    ]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Token",
      "description": "Pedir los tokens. Ejecútala primero: guarda tokenAdmin y tokenUsuario para el resto de la colección.",
      "item": [
        {
          "name": "Pedir token de administración",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve un token Bearer de ADMIN\", () => {",
                  "    pm.expect(datos.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(datos.tipo).to.eql(\"Bearer\");",
                  "    pm.expect(datos.rol).to.eql(\"ADMIN\");",
                  "});",
                  "pm.collectionVariables.set(\"tokenAdmin\", datos.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Pedir token de cliente (Laura)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{usuarioEmail}}\",\n  \"password\": \"{{usuarioPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test(\"Devuelve un token de USER\", () => pm.expect(datos.rol).to.eql(\"USER\"));",
                  "pm.collectionVariables.set(\"tokenUsuario\", datos.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Contraseña incorrecta: 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"otra-contraseña\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Explica el error\", () => pm.expect(pm.response.json().detail).to.eql(\"Email o contraseña incorrectos\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ver mi cuenta",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cuenta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cuenta"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const cuenta = pm.response.json();",
                  "pm.test(\"Es la cuenta del token\", () => pm.expect(cuenta.email).to.eql(pm.environment.get(\"adminEmail\")));",
                  "pm.test(\"No devuelve la contraseña\", () => pm.expect(cuenta).to.not.have.property(\"password\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ver mi cuenta sin token: 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cuenta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cuenta"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Indica cómo pedir el token\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"Bearer\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errores",
      "description": "Cómo responde la API cuando algo no se puede hacer: siempre JSON con status, title y detail.",
      "item": [
        {
          "name": "Ruta que no existe: 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/no-existe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "no-existe"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Formato Problem Details\", () => {",
                  "    const error = pm.response.json();",
                  "    pm.expect(error.status).to.eql(404);",
                  "    pm.expect(error.detail).to.include(\"/api/no-existe\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Token de cliente en administración: 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "usuarios"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenUsuario}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 403\", () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Se comprueba en todas las peticiones de la colección (un 204 no tiene cuerpo)",
          "if (pm.response.code !== 204) {",
          "    pm.test(\"Responde en JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/json/));",
          "}",
          "pm.test(\"Responde en menos de 2 segundos\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenUsuario",
      "value": ""
    }
  ]
}
